# =========================================================
# .gitignore — Graha Media (frontend + backend)
# =========================================================

# ---------- Rahasia & konfigurasi lokal (JANGAN di-commit) ----------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
supabase/.temp/

# ---------- Dependensi ----------
node_modules/
backend/node_modules/
.pnpm-store/

# ---------- Hasil build & cache ----------
dist/
build/
coverage/
.cache/
.vercel/
.railway/
*.tsbuildinfo

# ---------- Log ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- File unggahan & data uji ----------
uploads/
tmp/
*.pdf
!docs/**/*.pdf

# ---------- Python (layanan analisis warna) ----------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ---------- Editor & sistem operasi ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
