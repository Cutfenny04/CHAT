# Salin menjadi .env lalu isi. JANGAN commit file .env ke GitHub.
NODE_ENV=development
PORT=3000

# Connection string PostgreSQL Supabase (Project Settings → Database).
# Pakai role khusus aplikasi (lihat db/schema.sql), bukan role "postgres".
DATABASE_URL=postgresql://gm_app:GANTI_SANDI@db.xxxx.supabase.co:5432/postgres

# Rahasia JWT: minimal 32 karakter acak, mis. hasil `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG

# Asal frontend yang boleh memanggil API (pisahkan dengan koma)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Biaya bcrypt (12 untuk produksi)
BCRYPT_COST=12
